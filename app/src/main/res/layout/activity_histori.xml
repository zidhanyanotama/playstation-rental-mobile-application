<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="@color/black">

    <!-- Teks jika histori masih kosong -->
    <TextView
        android:id="@+id/empty_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HISTORI PEMESANAN"
        android:fontFamily="@font/oswald"
        android:textColor="@color/lightblue"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="20dp"/>


    <!-- ListView untuk histori -->
    <ListView
        android:id="@+id/list_histori"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/empty_message"
        android:layout_above="@+id/bottom_nav"
        android:divider="@android:color/transparent"
        android:dividerHeight="12dp"
        android:clipToPadding="false"
        android:paddingBottom="150dp"/>

    <Button
        android:id="@+id/btn_hapus_histori"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottom_nav"
        android:layout_centerHorizontal="true"
        android:backgroundTint="@color/red"
        android:text="HAPUS SEMUA HISTORI"
        android:fontFamily="@font/oswald"
        android:layout_marginBottom="12dp"/>


    <!-- BOTTOM NAVIGATION -->
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:paddingTop="2dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:background="@drawable/border_item"
        android:gravity="center">

        <Button
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="BERANDA"
            android:background="@null"
            android:drawableTint="@color/white"
            android:backgroundTint="#1F1F1F"
            android:drawableTop="@drawable/home"
            android:textSize="11sp"
            android:fontFamily="@font/oswald"
            android:textColor="@color/lightblue"
            android:tag="beranda"/>

        <Button
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="PESAN"
            android:drawableTint="@color/white"
            android:backgroundTint="#1F1F1F"
            android:drawableTop="@drawable/booking"
            android:textSize="11sp"
            android:fontFamily="@font/oswald"
            android:textColor="#FFA726"
            android:tag="pesan"/>

        <Button
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="HISTORI"
            android:drawableTop="@drawable/history"
            android:textSize="11sp"
            android:drawableTint="@color/white"
            android:backgroundTint="#1F1F1F"
            android:fontFamily="@font/oswald"
            android:textColor="#FFA726"
            android:tag="histori"/>

        <Button
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="AKUN"
            android:drawableTop="@drawable/profile"
            android:textSize="11sp"
            android:fontFamily="@font/oswald"
            android:drawableTint="@color/white"
            android:backgroundTint="#1F1F1F"
            android:textColor="#FFA726"
            android:tag="akun"/>

    </LinearLayout>
</RelativeLayout>
