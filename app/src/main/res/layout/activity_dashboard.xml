<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="16dp"
    android:backgroundTint="@color/darkblue"
    tools:context=".dashboard">

  <!-- SCROLL AREA -->
  <ScrollView
      android:id="@+id/scroll_area"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:layout_above="@id/bottom_nav"
      android:fillViewport="true">

    <LinearLayout
        android:id="@+id/scroll_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

      <!-- HEADER -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:layout_marginBottom="8dp">

        <!-- KIRI: HEADER TEXT -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

          <TextView
              android:id="@+id/header_text"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Halo, Selamat Datang!"
              android:fontFamily="@font/oswald"
              android:textSize="20sp"
              android:textStyle="bold"
              android:textColor="#FFFFFF" />

          <TextView
              android:id="@+id/subheader_text"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="ayo main sekarang!"
              android:fontFamily="@font/oswald"
              android:textSize="14sp"
              android:textColor="#CCCCCC" />
        </LinearLayout>

        <!-- KANAN: LOGO -->
        <ImageView
            android:id="@+id/logokecil"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/logo"
            android:layout_marginStart="16dp"/>
      </LinearLayout>

      <!--garisputihpembatas-->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="4dp"
          android:background="@drawable/border_item"
          android:layout_marginTop="-25dp"
          android:layout_marginBottom="10dp">
      </LinearLayout>

      <!--slider promo-->
      <androidx.recyclerview.widget.RecyclerView
          android:id="@+id/promoRecycler"
          android:layout_width="match_parent"
          android:layout_height="200dp"
          android:layout_marginBottom="12dp"
          android:paddingStart="8dp"
          android:paddingEnd="8dp"
          android:clipToPadding="false"
          />

      <!--garisputihpembatas-->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="4dp"
          android:background="@drawable/border_item"
          android:layout_marginTop="4dp"
          android:layout_marginBottom="10dp">
      </LinearLayout>

      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:layout_marginBottom="-8dp"
          android:text="GAME TERPOPULER"
          android:fontFamily="@font/oswald"
          android:textAlignment="center"
          android:textColor="@color/white"
          android:textStyle="bold"
          android:textSize="20sp"/>


      <!-- GRID LAYOUT -->
      <GridLayout
          android:id="@+id/foto_grid"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="16dp"
          android:layout_marginBottom="16dp"
          android:columnCount="3"
          android:rowCount="2"
          android:alignmentMode="alignMargins"
          android:useDefaultMargins="true"
          android:padding="0dp">

        <!-- FOTO 1 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:background="@drawable/border_item"
            android:gravity="center_horizontal"
            android:layout_margin="8dp">

          <ImageView
              android:layout_width="100dp"
              android:layout_height="130dp"
              android:src="@drawable/rdr2"
              android:scaleType="centerCrop" />

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Red Dead Redemption II"
              android:textAlignment="center"
              android:layout_marginBottom="8dp"
              android:fontFamily="@font/oswald"
              android:textColor="@color/lightblue"
              android:textSize="15sp"
              android:layout_marginTop="6dp"/>

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="IDR 100.000 / DAY"
              android:fontFamily="@font/oswald"
              android:textColor="@color/white"
              android:textSize="10sp"
              android:layout_marginTop="-5dp"/>
        </LinearLayout>

        <!-- FOTO 2 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:background="@drawable/border_item"
            android:gravity="center_horizontal"
            android:layout_margin="8dp">

          <ImageView
              android:layout_width="100dp"
              android:layout_height="130dp"
              android:src="@drawable/wukong"
              android:scaleType="centerCrop" />

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Black Myth Wukong"
              android:textAlignment="center"
              android:layout_marginBottom="8dp"
              android:fontFamily="@font/oswald"
              android:textColor="@color/lightblue"
              android:textSize="15sp"
              android:layout_marginTop="6dp"/>

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="IDR 100.000 / DAY"
              android:fontFamily="@font/oswald"
              android:textColor="@color/white"
              android:textSize="10sp"
              android:layout_marginTop="-5dp"/>
        </LinearLayout>

        <!-- FOTO 3 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:background="@drawable/border_item"
            android:gravity="center_horizontal"
            android:layout_margin="8dp">

          <ImageView
              android:layout_width="100dp"
              android:layout_height="130dp"
              android:src="@drawable/madden"
              android:scaleType="centerCrop" />

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="EA Sports Madden 2025"
              android:textAlignment="center"
              android:layout_marginBottom="8dp"
              android:fontFamily="@font/oswald"
              android:textColor="@color/lightblue"
              android:textSize="15sp"
              android:layout_marginTop="6dp"/>

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="IDR 100.000 / DAY"
              android:fontFamily="@font/oswald"
              android:textColor="@color/white"
              android:textSize="10sp"
              android:layout_marginTop="-5dp"/>
        </LinearLayout>

        <!-- FOTO 4 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:background="@drawable/border_item"
            android:gravity="center_horizontal"
            android:layout_margin="8dp">

          <ImageView
              android:layout_width="100dp"
              android:layout_height="130dp"
              android:src="@drawable/fc25"
              android:scaleType="centerCrop" />

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="EA Sports FC 2025"
              android:textAlignment="center"
              android:layout_marginBottom="8dp"
              android:fontFamily="@font/oswald"
              android:textColor="@color/lightblue"
              android:textSize="15sp"
              android:layout_marginTop="6dp"/>

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="IDR 100.000 / DAY"
              android:fontFamily="@font/oswald"
              android:textColor="@color/white"
              android:textSize="10sp"
              android:layout_marginTop="-5dp"/>
        </LinearLayout>

        <!-- FOTO 5 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:background="@drawable/border_item"
            android:gravity="center_horizontal"
            android:layout_margin="8dp">

          <ImageView
              android:layout_width="150dp"
              android:layout_height="130dp"
              android:src="@drawable/doom"
              android:scaleType="centerCrop" />

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Doom The Dark Ages"
              android:textAlignment="center"
              android:layout_marginBottom="8dp"
              android:fontFamily="@font/oswald"
              android:textColor="@color/lightblue"
              android:textSize="15sp"
              android:layout_marginTop="6dp"/>

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="IDR 100.000 / DAY"
              android:fontFamily="@font/oswald"
              android:textColor="@color/white"
              android:textSize="10sp"
              android:layout_marginTop="-5dp"/>
        </LinearLayout>

        <!-- FOTO 6 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:background="@drawable/border_item"
            android:gravity="center_horizontal"
            android:layout_margin="8dp">

          <ImageView
              android:layout_width="100dp"
              android:layout_height="130dp"
              android:src="@drawable/shadow"
              android:scaleType="centerCrop" />

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Assasin Creed Shadow"
              android:textAlignment="center"
              android:layout_marginBottom="8dp"
              android:fontFamily="@font/oswald"
              android:textColor="@color/lightblue"
              android:textSize="15sp"
              android:layout_marginTop="6dp"/>

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="IDR 100.000 / DAY"
              android:fontFamily="@font/oswald"
              android:textColor="@color/white"
              android:textSize="10sp"
              android:layout_marginTop="-5dp"/>
        </LinearLayout>
      </GridLayout>

      <!-- BUTTON GAME -->
      <LinearLayout
          android:id="@+id/btn_pesan"
          android:layout_width="110dp"
          android:layout_height="wrap_content"
          android:layout_gravity="center_horizontal"
          android:orientation="vertical"
          android:layout_marginBottom="20dp"
          android:gravity="center"
          android:background="@drawable/border_item"
          android:clickable="true"
          android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SEWA"
            android:textSize="12sp"
            android:textColor="@color/white"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:fontFamily="@font/oswald" />

      </LinearLayout>

    </LinearLayout>
  </ScrollView>

  <!-- BOTTOM NAVIGATION -->
  <LinearLayout
      android:id="@+id/bottom_nav"
      android:layout_width="match_parent"
      android:layout_height="80dp"
      android:paddingTop="2dp"
      android:layout_alignParentBottom="true"
      android:orientation="horizontal"
      android:background="@drawable/border_item"
      android:gravity="center">

    <Button
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="match_parent"
        android:text="BERANDA"
        android:drawableTint="@color/white"
        android:backgroundTint="#1F1F1F"
        android:drawableTop="@drawable/home"
        android:textSize="11sp"
        android:fontFamily="@font/oswald"
        android:textColor="@color/lightblue"
        android:tag="beranda"/>

    <Button
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="match_parent"
        android:text="PESAN"
        android:drawableTint="@color/white"
        android:backgroundTint="#1F1F1F"
        android:drawableTop="@drawable/booking"
        android:textSize="11sp"
        android:fontFamily="@font/oswald"
        android:textColor="#FFA726"
        android:tag="pesan"/>

    <Button
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="match_parent"
        android:text="HISTORI"
        android:drawableTop="@drawable/history"
        android:textSize="11sp"
        android:drawableTint="@color/white"
        android:backgroundTint="#1F1F1F"
        android:fontFamily="@font/oswald"
        android:textColor="#FFA726"
        android:tag="histori"/>

    <Button
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="match_parent"
        android:text="AKUN"
        android:drawableTop="@drawable/profile"
        android:textSize="11sp"
        android:fontFamily="@font/oswald"
        android:drawableTint="@color/white"
        android:backgroundTint="#1F1F1F"
        android:textColor="#FFA726"
        android:tag="akun"/>
  </LinearLayout>
</RelativeLayout>
