<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/darkblue"
    tools:context=".pesan">

    <RelativeLayout
        android:id="@+id/root_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PEMESANAN RENTAL"
            android:fontFamily="@font/oswald"
            android:textSize="24sp"
            android:textColor="@color/lightblue"
            android:textStyle="bold"
            android:layout_centerHorizontal="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:background="@drawable/border_icon"
            android:layout_below="@id/titleText"
            android:layout_marginTop="5dp" />

        <TextView
            android:id="@+id/label_ps_model"
            android:layout_width="wrap_content"
            android:fontFamily="@font/oswald"
            android:layout_marginLeft="12dp"
            android:layout_height="wrap_content"
            android:text="PILIH MODEL PS"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_below="@id/titleText"
            android:layout_marginTop="24dp" />

        <TextView
            android:id="@+id/label_duration"
            android:layout_width="wrap_content"
            android:fontFamily="@font/oswald"
            android:layout_marginLeft="96dp"
            android:layout_height="wrap_content"
            android:text="DURASI RENTAL"
            android:layout_toRightOf="@id/label_ps_model"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_below="@id/titleText"
            android:layout_marginTop="24dp" />

        <Spinner
            android:id="@+id/spinner_ps_model"
            android:layout_width="160dp"
            android:layout_height="48dp"
            android:layout_below="@id/label_ps_model"
            android:layout_marginTop="2dp"
            android:backgroundTint="@color/lightblue"
            android:background="@drawable/border_item"
            android:popupBackground="@color/white"
            android:spinnerMode="dropdown" />

        <Spinner
            android:id="@+id/spinner_duration"
            android:layout_width="160dp"
            android:layout_height="48dp"
            android:layout_marginLeft="30dp"
            android:layout_toRightOf="@id/spinner_ps_model"
            android:layout_below="@id/label_duration"
            android:layout_marginTop="2dp"
            android:backgroundTint="@color/lightblue"
            android:background="@drawable/border_item"
            android:popupBackground="@color/white"
            android:spinnerMode="dropdown" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cardview"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_below="@id/spinner_ps_model"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="26dp"
            app:cardElevation="6dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/imageView"
                    android:padding="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ps2" />

            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="* GAME INCLUDE"
            android:textSize="12sp"
            android:textColor="@color/lightblue"
            android:fontFamily="@font/oswald"
            android:id="@+id/note1"
            android:layout_below="@id/cardview"
            android:layout_marginTop="8dp"
            android:layout_marginLeft="10dp"
            android:textStyle="italic" />

        <!-- Game 1 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardview2"
            android:layout_width="160dp"
            android:layout_height="180dp"
            android:layout_below="@id/note1"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="26dp"
            app:cardElevation="6dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/imageView2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ps2gta" />

                <TextView
                    android:id="@+id/textView2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:layout_margin="8dp"
                    android:text="GTA San Andreas"
                    android:textColor="#FFFFFF"
                    android:background="#80000000"
                    android:padding="4dp"
                    android:textSize="14sp"
                    android:fontFamily="@font/oswald"/>
            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <!-- Game 2 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardview3"
            android:layout_width="160dp"
            android:layout_height="180dp"
            android:layout_below="@id/note1"
            android:layout_toRightOf="@id/cardview2"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="26dp"
            app:cardElevation="6dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/imageView3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ps2god" />

                <TextView
                    android:id="@+id/textView3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:layout_margin="8dp"
                    android:text="God Of War"
                    android:textColor="#FFFFFF"
                    android:background="#80000000"
                    android:padding="4dp"
                    android:textSize="14sp"
                    android:fontFamily="@font/oswald"/>
            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <!-- Game 3 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardview4"
            android:layout_width="160dp"
            android:layout_height="180dp"
            android:layout_below="@id/cardview3"
            android:layout_marginTop="25dp"
            app:cardCornerRadius="26dp"
            app:cardElevation="6dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/imageView4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ps2ff" />

                <TextView
                    android:id="@+id/textView4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:layout_margin="8dp"
                    android:text="Final Fantasy"
                    android:textColor="#FFFFFF"
                    android:background="#80000000"
                    android:padding="4dp"
                    android:textSize="14sp"
                    android:fontFamily="@font/oswald"/>
            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <!-- Game 4 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardview5"
            android:layout_width="160dp"
            android:layout_height="180dp"
            android:layout_below="@id/cardview3"
            android:layout_toRightOf="@id/cardview4"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="25dp"
            app:cardCornerRadius="26dp"
            app:cardElevation="6dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/imageView5"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ps2we" />

                <TextView
                    android:id="@+id/textView5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:layout_margin="8dp"
                    android:text="Winning Eleven 10"
                    android:textColor="#FFFFFF"
                    android:background="#80000000"
                    android:padding="4dp"
                    android:textSize="14sp"
                    android:fontFamily="@font/oswald"/>
            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/button_date_picker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TANGGAL MULAI"
            android:layout_below="@id/cardview4"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/black"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/selected_date_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="* BELUM ADA TANGGAL YANG DIPILIH !"
            android:textColor="#CCCC"
            android:textSize="12sp"
            android:fontFamily="@font/oswald"
            android:layout_below="@id/button_date_picker"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/input_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/selected_date_text"
            android:layout_marginTop="8dp"
            android:inputType="textPersonName"
            android:hint="masukkan nama anda"
            android:textColor="@color/white"
            android:textColorHint="#CCCC"
            android:fontFamily="@font/oswald"
            android:padding="12dp" />

        <EditText
            android:id="@+id/input_phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/input_name"
            android:layout_marginTop="8dp"
            android:inputType="phone"
            android:hint="masukkan nomor anda"
            android:textColor="@color/white"
            android:textColorHint="#CCCC"
            android:fontFamily="@font/oswald"
            android:padding="12dp" />

        <CheckBox
            android:id="@+id/checkbox_delivery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/input_phone"
            android:text="Antar ke rumah saya"
            android:textColor="@color/white"
            android:fontFamily="@font/oswald"
            android:layout_marginTop="10dp"/>

        <EditText
            android:id="@+id/input_alamat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/checkbox_delivery"
            android:hint="Masukkan alamat lengkap"
            android:visibility="gone"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/lightblue"
            android:inputType="textPostalAddress"
            android:textColor="@color/white"
            android:textColorHint="#AAAAAA"/>

        <Button
            android:id="@+id/button_confirm"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_below="@id/input_alamat"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="40dp"
            android:text="KONFIRMASI PEMESANAN"
            android:backgroundTint="@color/lightblue"
            android:textColor="#000000" />

    </RelativeLayout>
</ScrollView>
