<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@color/black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/border_item"
        android:padding="16dp"
        android:elevation="4dp">

        <!-- Judul -->
        <TextView
            android:id="@+id/text_receipt_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Detail Pemesanan"
            android:fontFamily="@font/oswald"
            android:layout_marginBottom="16dp"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_gravity="center_horizontal" />

        <!-- Garis pembatas -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginBottom="8dp" />

        <!-- Detail Pesanan -->
        <TextView
            android:id="@+id/text_nama"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#CCCCCC"
            android:text="Nama: Zidhan" />

        <TextView
            android:id="@+id/text_phone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#CCCCCC"
            android:text="No HP: 08xxxxx" />

        <TextView
            android:id="@+id/text_model"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#CCCCCC"
            android:text="Model PS: PS4" />

        <TextView
            android:id="@+id/text_durasi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#CCCCCC"
            android:text="Durasi: 3 Hari" />

        <TextView
            android:id="@+id/text_tanggal_awal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#CCCCCC"
            android:text="Tanggal Awal: 01/07/2025" />

        <TextView
            android:id="@+id/text_tanggal_akhir"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#CCCCCC"
            android:text="Tanggal Akhir: 04/07/2025" />

        <TextView
            android:id="@+id/text_layanan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#CCCCCC"
            android:text="Layanan: Antar ke rumah" />

        <TextView
            android:id="@+id/text_alamat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#CCCCCC"
            android:text="Alamat: Jl. Sudirman No. 123" />

        <TextView
            android:id="@+id/text_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Total Harga: Rp 30000"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <!-- Garis pembatas -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp" />

        <!-- Judul metode pembayaran -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pilih Metode Pembayaran:"
            android:textStyle="bold" />

        <!-- Tombol COD -->
        <Button
            android:id="@+id/btn_cod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bayar di Tempat (COD)"
            android:backgroundTint="@color/red"
            android:textColor="@android:color/white"
            android:layout_marginTop="8dp" />

        <!-- Tombol Transfer -->
        <Button
            android:id="@+id/btn_transfer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Transfer Bank"
            android:backgroundTint="@color/black"
            android:textColor="@android:color/white"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:id="@+id/layout_transfer_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingTop="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Transfer ke rekening berikut:"
                android:textStyle="bold"
                android:textColor="#CCCCCC"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bank BCA - 1234567890"
                android:layout_marginTop="4dp"
                android:textColor="#CCCCCC"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="a.n. PT Rental PS"
                android:textColor="#CCCCCC"/>

            <Button
                android:id="@+id/btn_upload_bukti"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/lightblue"
                android:text="Upload Bukti Transfer"
                android:layout_marginTop="12dp" />

            <ImageView
                android:id="@+id/image_bukti"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="8dp"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_konfirmasi_transfer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Konfirmasi Pembayaran"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/red"
                android:textColor="@android:color/white" />
        </LinearLayout>


    </LinearLayout>
</ScrollView>
